<IfModule mod_rewrite.c>
    RewriteEngine On

    # Opciones
    Options -Indexes +FollowSymLinks

    # CORS se maneja exclusivamente en PHP (App::handleCors / cors.php).
    # NO duplicar headers de CORS aca: Apache pisa con "Header set" lo que
    # PHP ya calculo correctamente por origen, y ademas rompe la combinacion
    # Origin "*" + Credentials true (invalida por spec cuando hay cookies/sesion).

    # No redirigir archivos existentes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir todo a index.php (incluye OPTIONS: index.php -> App::handleCors()
    # ya responde 200 con los headers correctos y hace exit(0))
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Proteger archivos sensibles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(env|ini|log|sql|json)$">
    Order allow,deny
    Deny from all
</FilesMatch>